{
  "name": "codex-threadbox-vscode",
  "displayName": "Codex Threadbox",
  "description": "Manage Codex tasks and projects from the native VS Code sidebar, locally or remotely.",
  "version": "1.0.0",
  "publisher": "irisNeko",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/iris-Neko/codex-threadbox.git"
  },
  "homepage": "https://github.com/iris-Neko/codex-threadbox",
  "files": [
    "dist/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "codex",
    "tasks",
    "remote ssh"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:threadbox.sidebar",
    "onView:threadbox.sidebar.codexPrimary",
    "onView:threadbox.sidebar.codexSecondary"
  ],
  "main": "./dist/extension.cjs",
  "icon": "dist/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "threadbox.toggleMultiSelect",
        "title": "Toggle Multi-select Mode",
        "category": "Threadbox",
        "icon": "$(checklist)",
        "toggled": "threadbox.multiSelectMode"
      },
      {
        "command": "threadbox.refreshSidebar",
        "title": "Refresh",
        "category": "Threadbox",
        "icon": "$(refresh)"
      },
      {
        "command": "threadbox.updateCodexCli",
        "title": "Install or Update Codex CLI",
        "category": "Threadbox",
        "icon": "$(cloud-download)"
      },
      {
        "command": "threadbox.searchSidebar",
        "title": "Search Tasks",
        "category": "Threadbox",
        "icon": "$(search)"
      },
      {
        "command": "threadbox.clearSidebarSearch",
        "title": "Clear Task Search",
        "category": "Threadbox",
        "icon": "$(clear-all)"
      },
      {
        "command": "threadbox.newProject",
        "title": "New Project",
        "category": "Threadbox",
        "icon": "$(new-folder)"
      },
      {
        "command": "threadbox.importCurrentWorkspaceProject",
        "title": "Import Current Workspace",
        "category": "Threadbox",
        "icon": "$(root-folder-opened)"
      },
      {
        "command": "threadbox.newThreadInProject",
        "title": "New Task",
        "category": "Threadbox",
        "icon": "$(add)"
      },
      {
        "command": "threadbox.renameProject",
        "title": "Rename Project",
        "category": "Threadbox",
        "icon": "$(edit)"
      },
      {
        "command": "threadbox.renameThread",
        "title": "Rename Task...",
        "category": "Threadbox",
        "icon": "$(edit)"
      },
      {
        "command": "threadbox.deleteProject",
        "title": "Delete Project",
        "category": "Threadbox"
      },
      {
        "command": "threadbox.moveToProject",
        "title": "Move to Project...",
        "category": "Threadbox",
        "icon": "$(folder-opened)"
      },
      {
        "command": "threadbox.archive",
        "title": "Archive",
        "category": "Threadbox"
      },
      {
        "command": "threadbox.unarchive",
        "title": "Unarchive",
        "category": "Threadbox"
      },
      {
        "command": "threadbox.pin",
        "title": "Pin",
        "category": "Threadbox"
      },
      {
        "command": "threadbox.unpin",
        "title": "Unpin",
        "category": "Threadbox"
      },
      {
        "command": "threadbox.delete",
        "title": "Move to Trash...",
        "category": "Threadbox"
      },
      {
        "command": "threadbox.restoreFromTrash",
        "title": "Restore from Trash",
        "category": "Threadbox"
      },
      {
        "command": "threadbox.emptyTrash",
        "title": "Empty Trash...",
        "category": "Threadbox"
      },
      {
        "command": "threadbox.copyId",
        "title": "Copy Task ID",
        "category": "Threadbox"
      },
      {
        "command": "threadbox.openDirectory",
        "title": "Open Working Directory",
        "category": "Threadbox"
      },
      {
        "command": "threadbox.openInCodex",
        "title": "Open in Codex",
        "category": "Threadbox",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "threadbox.filterSidebar",
        "title": "Filter Tasks...",
        "category": "Threadbox",
        "icon": "$(filter)"
      },
      {
        "command": "threadbox.sortSidebar",
        "title": "Sort Tasks...",
        "category": "Threadbox",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "threadbox.resetFilters",
        "title": "Clear All Filters",
        "category": "Threadbox",
        "icon": "$(clear-all)"
      },
      {
        "command": "threadbox.selectFiltered",
        "title": "Select Filtered Tasks (excluding Trash)",
        "category": "Threadbox",
        "icon": "$(check-all)"
      },
      {
        "command": "threadbox.clearSelection",
        "title": "Clear Checked Tasks",
        "category": "Threadbox",
        "icon": "$(clear-all)"
      },
      {
        "command": "threadbox.openSettings",
        "title": "Open Settings",
        "category": "Threadbox",
        "icon": "$(settings-gear)"
      },
      {
        "command": "threadbox.trashSelected",
        "title": "Move Checked Tasks to Trash...",
        "category": "Threadbox",
        "icon": "$(trash)"
      },
      {
        "command": "threadbox.archiveSelected",
        "title": "Archive Checked Tasks...",
        "category": "Threadbox",
        "icon": "$(archive)"
      },
      {
        "command": "threadbox.unarchiveSelected",
        "title": "Unarchive Checked Tasks...",
        "category": "Threadbox",
        "icon": "$(archive)"
      },
      {
        "command": "threadbox.restoreSelected",
        "title": "Restore Checked Tasks from Trash...",
        "category": "Threadbox",
        "icon": "$(discard)"
      },
      {
        "command": "threadbox.moveSelected",
        "title": "Move Checked Tasks to Project...",
        "category": "Threadbox",
        "icon": "$(folder-opened)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "threadbox",
          "title": "Threadbox",
          "icon": "dist/activitybar.svg",
          "when": "config.threadbox.sidebarLocation == standalone || !threadbox.codexContainerAvailable"
        }
      ]
    },
    "views": {
      "threadbox": [
        {
          "id": "threadbox.sidebar",
          "name": "Codex Tasks",
          "when": "config.threadbox.sidebarLocation == standalone || !threadbox.codexContainerAvailable"
        }
      ],
      "codexViewContainer": [
        {
          "id": "threadbox.sidebar.codexPrimary",
          "name": "Threadbox",
          "contextualTitle": "Threadbox: Codex Tasks",
          "visibility": "collapsed",
          "when": "config.threadbox.sidebarLocation == codex && threadbox.codexContainerAvailable && chatgpt.doesNotSupportSecondarySidebar"
        }
      ],
      "codexSecondaryViewContainer": [
        {
          "id": "threadbox.sidebar.codexSecondary",
          "name": "Threadbox",
          "contextualTitle": "Threadbox: Codex Tasks",
          "visibility": "collapsed",
          "when": "config.threadbox.sidebarLocation == codex && threadbox.codexContainerAvailable && !chatgpt.doesNotSupportSecondarySidebar"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "threadbox.searchSidebar",
          "when": "view =~ /^threadbox\\.sidebar/",
          "group": "navigation@1"
        },
        {
          "command": "threadbox.filterSidebar",
          "when": "view =~ /^threadbox\\.sidebar/",
          "group": "navigation@2"
        },
        {
          "command": "threadbox.refreshSidebar",
          "when": "view =~ /^threadbox\\.sidebar/",
          "group": "navigation@3"
        },
        {
          "command": "threadbox.toggleMultiSelect",
          "when": "view =~ /^threadbox\\.sidebar/",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "threadbox.renameThread",
          "when": "view =~ /^threadbox\\.sidebar/ && viewItem =~ /^threadbox\\.thread\\.active\\./",
          "group": "manage@0"
        },
        {
          "command": "threadbox.openInCodex",
          "when": "view =~ /^threadbox\\.sidebar/ && viewItem =~ /^threadbox\\.thread\\./",
          "group": "navigation@0"
        },
        {
          "command": "threadbox.newProject",
          "when": "view =~ /^threadbox\\.sidebar/ && viewItem == threadbox.projects",
          "group": "inline@1"
        },
        {
          "command": "threadbox.importCurrentWorkspaceProject",
          "when": "view =~ /^threadbox\\.sidebar/ && viewItem == threadbox.projects && workspaceFolderCount > 0",
          "group": "inline@2"
        },
        {
          "command": "threadbox.renameProject",
          "when": "view =~ /^threadbox\\.sidebar/ && viewItem == threadbox.project.threadbox.mutable",
          "group": "inline@1"
        },
        {
          "command": "threadbox.newThreadInProject",
          "when": "view =~ /^threadbox\\.sidebar/ && viewItem == threadbox.project.threadbox.mutable",
          "group": "inline@0"
        },
        {
          "command": "threadbox.deleteProject",
          "when": "view =~ /^threadbox\\.sidebar/ && viewItem == threadbox.project.threadbox.mutable",
          "group": "project@2"
        },
        {
          "command": "threadbox.moveToProject",
          "when": "view =~ /^threadbox\\.sidebar/ && viewItem =~ /^threadbox\\.(thread|group)\\./",
          "group": "project@1"
        },
        {
          "command": "threadbox.archive",
          "when": "view =~ /^threadbox\\.sidebar/ && viewItem =~ /^threadbox\\.thread\\.active\\./",
          "group": "manage@1"
        },
        {
          "command": "threadbox.unarchive",
          "when": "view =~ /^threadbox\\.sidebar/ && viewItem =~ /^threadbox\\.thread\\.archived\\./",
          "group": "manage@1"
        },
        {
          "command": "threadbox.pin",
          "when": "view =~ /^threadbox\\.sidebar/ && viewItem =~ /\\.unpinned$/",
          "group": "manage@2"
        },
        {
          "command": "threadbox.unpin",
          "when": "view =~ /^threadbox\\.sidebar/ && viewItem =~ /\\.pinned$/",
          "group": "manage@2"
        },
        {
          "command": "threadbox.copyId",
          "when": "view =~ /^threadbox\\.sidebar/ && viewItem =~ /^threadbox\\.thread\\./",
          "group": "navigation@1"
        },
        {
          "command": "threadbox.openDirectory",
          "when": "view =~ /^threadbox\\.sidebar/ && viewItem =~ /^threadbox\\.thread\\./",
          "group": "navigation@2"
        },
        {
          "command": "threadbox.delete",
          "when": "view =~ /^threadbox\\.sidebar/ && viewItem =~ /^threadbox\\.thread\\.(active|archived)\\./",
          "group": "danger@1"
        },
        {
          "command": "threadbox.restoreFromTrash",
          "when": "view =~ /^threadbox\\.sidebar/ && viewItem =~ /^threadbox\\.thread\\.trash\\./",
          "group": "manage@1"
        },
        {
          "command": "threadbox.emptyTrash",
          "when": "view =~ /^threadbox\\.sidebar/ && viewItem == threadbox.project.threadbox.trash",
          "group": "danger@1"
        },
        {
          "command": "threadbox.newProject",
          "when": "view =~ /^threadbox\\.sidebar/ && viewItem =~ /^threadbox\\.(projects|project|group)/",
          "group": "create@1"
        },
        {
          "command": "threadbox.importCurrentWorkspaceProject",
          "when": "view =~ /^threadbox\\.sidebar/ && viewItem =~ /^threadbox\\.(projects|project|group)/ && workspaceFolderCount > 0",
          "group": "create@2"
        },
        {
          "command": "threadbox.sortSidebar",
          "when": "view =~ /^threadbox\\.sidebar/ && viewItem =~ /^threadbox\\.(projects|project|group)/",
          "group": "view@1"
        },
        {
          "command": "threadbox.resetFilters",
          "when": "view =~ /^threadbox\\.sidebar/ && viewItem =~ /^threadbox\\.(projects|project|group)/",
          "group": "view@2"
        },
        {
          "command": "threadbox.openSettings",
          "when": "view =~ /^threadbox\\.sidebar/ && viewItem =~ /^threadbox\\.(projects|project|group)/",
          "group": "view@3"
        },
        {
          "command": "threadbox.selectFiltered",
          "when": "view =~ /^threadbox\\.sidebar/ && threadbox.multiSelectMode",
          "group": "selection"
        },
        {
          "command": "threadbox.clearSelection",
          "when": "view =~ /^threadbox\\.sidebar/ && threadbox.multiSelectMode",
          "group": "selection"
        }
      ]
    },
    "configuration": {
      "title": "Threadbox for Codex",
      "properties": {
        "threadbox.codexBinary": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path or command for the Codex CLI on the extension host. `CODEX_BINARY` is used when empty."
        },
        "threadbox.codexHome": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Codex home directory on the extension host. `CODEX_HOME` is used when empty."
        },
        "threadbox.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "zh-CN"
          ],
          "default": "auto",
          "scope": "machine",
          "description": "Language used by the Threadbox sidebar."
        },
        "threadbox.sidebarLocation": {
          "type": "string",
          "enum": [
            "codex",
            "standalone"
          ],
          "enumDescriptions": [
            "Show Threadbox as a collapsible view inside the official Codex sidebar.",
            "Show Threadbox in its own Activity Bar container."
          ],
          "default": "codex",
          "scope": "window",
          "description": "Controls where the Threadbox task tree is shown. The standalone container is used automatically when a compatible Codex sidebar is unavailable."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "npm run build && node scripts/package-vsix.mjs",
    "test:extension": "npm run package && node scripts/test-extension.mjs"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.28.2"
  }
}
