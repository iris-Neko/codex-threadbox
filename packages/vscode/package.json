{
  "name": "threadbox-for-codex",
  "displayName": "Threadbox for Codex",
  "description": "Manage Codex tasks locally, including on Remote SSH, Dev Containers, and Codespaces.",
  "version": "0.4.1",
  "publisher": "irisNeko",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/iris-Neko/codex-threadbox.git"
  },
  "homepage": "https://github.com/iris-Neko/codex-threadbox",
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "codex",
    "tasks",
    "remote ssh"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onCommand:threadbox.openManager",
    "onView:threadbox.sidebar"
  ],
  "main": "./dist/extension.cjs",
  "icon": "dist/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "threadbox.openManager",
        "title": "Open Manager",
        "category": "Threadbox",
        "icon": "$(open-preview)"
      },
      {
        "command": "threadbox.refreshSidebar",
        "title": "Refresh",
        "category": "Threadbox",
        "icon": "$(refresh)"
      },
      {
        "command": "threadbox.searchSidebar",
        "title": "Search Tasks",
        "category": "Threadbox",
        "icon": "$(search)"
      },
      {
        "command": "threadbox.clearSidebarSearch",
        "title": "Clear Task Search",
        "category": "Threadbox",
        "icon": "$(clear-all)"
      },
      {
        "command": "threadbox.newProject",
        "title": "New Project",
        "category": "Threadbox",
        "icon": "$(new-folder)"
      },
      {
        "command": "threadbox.renameProject",
        "title": "Rename Project",
        "category": "Threadbox",
        "icon": "$(edit)"
      },
      {
        "command": "threadbox.deleteProject",
        "title": "Delete Project",
        "category": "Threadbox"
      },
      {
        "command": "threadbox.moveToProject",
        "title": "Move to Project...",
        "category": "Threadbox",
        "icon": "$(folder-opened)"
      },
      {
        "command": "threadbox.archive",
        "title": "Archive",
        "category": "Threadbox"
      },
      {
        "command": "threadbox.unarchive",
        "title": "Unarchive",
        "category": "Threadbox"
      },
      {
        "command": "threadbox.pin",
        "title": "Pin",
        "category": "Threadbox"
      },
      {
        "command": "threadbox.unpin",
        "title": "Unpin",
        "category": "Threadbox"
      },
      {
        "command": "threadbox.delete",
        "title": "Delete Permanently...",
        "category": "Threadbox"
      },
      {
        "command": "threadbox.copyId",
        "title": "Copy Task ID",
        "category": "Threadbox"
      },
      {
        "command": "threadbox.openDirectory",
        "title": "Open Working Directory",
        "category": "Threadbox"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "threadbox",
          "title": "Threadbox",
          "icon": "dist/activitybar.svg"
        }
      ]
    },
    "views": {
      "threadbox": [
        {
          "id": "threadbox.sidebar",
          "name": "Codex Tasks"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "threadbox.openManager",
          "when": "view == threadbox.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "threadbox.searchSidebar",
          "when": "view == threadbox.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "threadbox.clearSidebarSearch",
          "when": "view == threadbox.sidebar && threadbox.searchActive",
          "group": "navigation@3"
        },
        {
          "command": "threadbox.refreshSidebar",
          "when": "view == threadbox.sidebar",
          "group": "navigation@4"
        },
        {
          "command": "threadbox.newProject",
          "when": "view == threadbox.sidebar",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "threadbox.newProject",
          "when": "view == threadbox.sidebar && viewItem == threadbox.projects",
          "group": "inline@1"
        },
        {
          "command": "threadbox.renameProject",
          "when": "view == threadbox.sidebar && viewItem == threadbox.project.threadbox",
          "group": "inline@1"
        },
        {
          "command": "threadbox.deleteProject",
          "when": "view == threadbox.sidebar && viewItem == threadbox.project.threadbox",
          "group": "project@2"
        },
        {
          "command": "threadbox.moveToProject",
          "when": "view == threadbox.sidebar && viewItem =~ /^threadbox\\.thread\\./",
          "group": "inline@1"
        },
        {
          "command": "threadbox.moveToProject",
          "when": "view == threadbox.sidebar && viewItem =~ /^threadbox\\.group\\./",
          "group": "inline@1"
        },
        {
          "command": "threadbox.moveToProject",
          "when": "view == threadbox.sidebar && viewItem =~ /^threadbox\\.(thread|group)\\./",
          "group": "project@1"
        },
        {
          "command": "threadbox.archive",
          "when": "view == threadbox.sidebar && viewItem =~ /^threadbox\\.thread\\.active\\./",
          "group": "manage@1"
        },
        {
          "command": "threadbox.unarchive",
          "when": "view == threadbox.sidebar && viewItem =~ /^threadbox\\.thread\\.archived\\./",
          "group": "manage@1"
        },
        {
          "command": "threadbox.pin",
          "when": "view == threadbox.sidebar && viewItem =~ /\\.unpinned$/",
          "group": "manage@2"
        },
        {
          "command": "threadbox.unpin",
          "when": "view == threadbox.sidebar && viewItem =~ /\\.pinned$/",
          "group": "manage@2"
        },
        {
          "command": "threadbox.copyId",
          "when": "view == threadbox.sidebar && viewItem =~ /^threadbox\\.thread\\./",
          "group": "navigation@1"
        },
        {
          "command": "threadbox.openDirectory",
          "when": "view == threadbox.sidebar && viewItem =~ /^threadbox\\.thread\\./",
          "group": "navigation@2"
        },
        {
          "command": "threadbox.delete",
          "when": "view == threadbox.sidebar && viewItem =~ /^threadbox\\.thread\\./",
          "group": "danger@1"
        }
      ]
    },
    "configuration": {
      "title": "Threadbox for Codex",
      "properties": {
        "threadbox.codexBinary": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path or command for the Codex CLI on the extension host. `CODEX_BINARY` is used when empty."
        },
        "threadbox.codexHome": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Codex home directory on the extension host. `CODEX_HOME` is used when empty."
        },
        "threadbox.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "zh-CN"
          ],
          "default": "auto",
          "scope": "machine",
          "description": "Language used by the Threadbox manager."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "npm run build && node scripts/package-vsix.mjs",
    "test:extension": "npm run package && node scripts/test-extension.mjs"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.28.2"
  }
}
